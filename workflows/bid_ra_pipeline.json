- Fire Bid Fetch","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[920,120],"parameters":{"method":"POST","url":"http://127.0.0.1:8888/run-bid-fetch","sendQuery":true,"queryParameters":{"parameters":[{"name":"workers","value":"={{ $('Set CPU Mode').first().json.fetch_workers }}"}]},"options":{}}},{"id":"a9c8b2cc-90de-484d-b93d-1bdf6599bccd","name":"Wait 90 min - Fetch","type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[1140,120],"parameters":{"resume":"timeInterval","amount":90,"unit":"minutes"}},{"id":"cd746eef-3956-4a76-958c-049a6e600c82","name":"Stage 2A - Fire Scrape Bids","type":"n8n-nodes-base.noOp","typeVersion":1,"position":[1380,0],"parameters":{}},{"id":"596d61e1-b15f-49e1-ab6f-8ac0e009d8cf","name":"Stage 2B - Fire Scrape RA","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1380,240],"parameters":{"method":"POST","url":"http://127.0.0.1:8888/run-scrape-ra","sendQuery":true,"queryParameters":{"parameters":[{"name":"workers","value":"={{ $('Set CPU Mode').first().json.scrape_workers }}"}]},"options":{}}},{"id":"1f357ca1-5f28-4273-b7d7-b74aa7667cd6","name":"Merge - Scraping Done","type":"n8n-nodes-base.merge","typeVersion":3,"position":[1620,120],"parameters":{"mode":"append"}},{"id":"3e54d1de-e3f2-4f0b-b0f5-cf0af4746abf","name":"Wait 45 min","type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[1840,120],"parameters":{"resume":"timeInterval","amount":45,"unit":"minutes"}},{"id":"bb1ecf88-e135-473a-9a4f-7e9a2f1fdede","name":"Stage 2C - Fire All 5 Downloads","type":"n8n-nodes-base.code","typeVersion":2,"position":[2060,120],"parameters":{"language":"javaScript","jsCode":"const http = require('http');\n\nfunction post(path) {\n  return new Promise((resolve) => {\n    const req = http.request(\n      { host: '127.0.0.1', port: 8888, path, method: 'POST' },\n      res => {\n        let d = '';\n        res.on('data', c => d += c);\n        res.on('end', () => { try { resolve(JSON.parse(d)); } catch { resolve({}); } });\n      }\n    );\n    req.on('error', () => resolve({}));\n    req.end();\n  });\n}\n\nconst workers = $('Set CPU Mode').first().json.download_workers;\nconst results = await Promise.all(\n  [1,2,3,4,5].map(i => post(`/run-download-bid-pdfs?instance=${i}&workers=${workers}`))\n);\nreturn results.map((r, i) => ({ json: { instance: i+1, ...r } }));"}},{"id":"b2c6464c-425d-4b4c-b77f-6e19fe44b73e","name":"Wait 90 min - Downloads","type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[2280,120],"parameters":{"resume":"timeInterval","amount":90,"unit":"minutes"}},{"id":"08dfb54b-fad7-4791-9692-9c0ba474dba0","name":"Stage 3A - Fire Extract Bid PDFs","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[2520,0],"parameters":{"method":"POST","url":"http://127.0.0.1:8888/run-extract-bid-pdfs","sendQuery":true,"queryParameters":{"parameters":[{"name":"workers","value":"={{ $('Set CPU Mode').first().json.extract_bid_workers }}"}]},"options":{}}},{"id":"192d5485-f7b7-4054-aecb-c6b47ac204c8","name":"Stage 3B - Fire Extract RA PDFs","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[2520,240],"parameters":{"method":"POST","url":"http://127.0.0.1:8888/run-extract-ra-pdfs","sendQuery":true,"queryParameters":{"parameters":[{"name":"workers","value":"={{ $('Set CPU Mode').first().json.extract_ra_workers }}"}]},"options":{}}},{"id":"6f31a0a7-3f41-434b-b77e-43c84fe2e81f","name":"Merge - Extraction Done","type":"n8n-nodes-base.merge","typeVersion":3,"position":[2760,120],"parameters":{"mode":"append"}},{"id":"6bb1b2ca-7523-4b8f-91ce-ba34f2df48b7","name":"Wait 120 min","type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[2980,120],"parameters":{"resume":"timeInterval","amount":120,"unit":"minutes"}},{"id":"10e002df-4c76-4e6e-b389-bc007a901265","name":"Stage 3.5 - Fire Bundle Docs","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[3200,120],"parameters":{"method":"POST","url":"http://127.0.0.1:8888/run-bundle-bid-docs","options":{}}},