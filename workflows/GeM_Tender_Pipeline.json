        "jsCode": "const rows = $input.all().map(i => i.json);\nconst total = rows.reduce((s, r) => s + parseInt(r.count || 0), 0);\nconst now = new Date();\nconst dateStr = now.toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata', dateStyle: 'long' });\nconst timeStr = now.toLocaleTimeString('en-IN', { timeZone: 'Asia/Kolkata' });\nconst lines = rows.map(r =>\n  `  DL:${r.download_status||'-'} | HL:${r.hyperlink_status||'-'} | HLD:${r.hyperlink_download_status||'-'} | BD:${r.bid_extraction_status||'-'} | CAT:${r.to_be_processed_by_gemini||'-'} | GEM:${r.gemini_processing_status||'-'} -> ${r.count}`\n).join('\\n');\nconst message = [\n  '=====================================',\n  '\\u2705 GeM Tender Pipeline Completed', '',\n  'Date: ' + dateStr, 'Time: ' + timeStr,\n  'Total Bid Count: ' + total, '',\n  'Status Summary:', lines,\n  '=====================================',\n].join('\\n');\nreturn [{ json: { message, total, rows } }];"
      },
