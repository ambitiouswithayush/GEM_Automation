      "parameters": {
        "authentication": "privateKey",
        "host": "127.0.0.1",
        "port": 9357,
        "username": "ayushh123",
        "command": "# Sample CPU idle over 2 quick readings\nIDLE1=$(top -bn1 | grep '%Cpu' | awk '{for(i=1;i<=NF;i++) if($i~/id,/) print $(i-1)}')\nsleep 1\nIDLE2=$(top -bn1 | grep '%Cpu' | awk '{for(i=1;i<=NF;i++) if($i~/id,/) print $(i-1)}')\nIDLE=$(echo \"($IDLE1 + $IDLE2) / 2\" | bc -l 2>/dev/null || echo $IDLE1)\nUSED=$(echo \"100 - $IDLE\" | bc -l 2>/dev/null | xargs printf '%.1f')\necho \"CPU_USED:${USED}\"\n# Warn if > 50%, hard block if > 80%\nINT_USED=$(echo $USED | cut -d'.' -f1)\n[ \"$INT_USED\" -ge 80 ] && echo 'CPU_STATUS:HIGH' || ([ \"$INT_USED\" -ge 50 ] && echo 'CPU_STATUS:WARN' || echo 'CPU_STATUS:OK')",
        "options": {
          "timeout": 15000
        }
      }
    },
