      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        500
      ],
      "parameters": {
        "jsCode": "const startTime = $execution.startedAt ? new Date($execution.startedAt).getTime() : Date.now();\nconst elapsed = Date.now() - startTime;\nconst FOUR_HOURS = 4 * 60 * 60 * 1000;\nconst timedOut = elapsed > FOUR_HOURS;\nreturn [{ json: { timedOut, elapsed_hours: Math.round(elapsed / 3600000 * 10) / 10 } }];"
      }
    },
    {
